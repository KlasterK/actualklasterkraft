export module actualklasterkraft.world.blockstates;

template <typename T, typename... Args>
consteval auto guarantee_sorted_array(Args... args)
{
    std::array<T, sizeof...(Args)> array { static_cast<T>(args)... };
    if (!std::ranges::is_sorted(array))
        throw;
    return array;
}

export constexpr size_t BlockExtent = 16, BiomeExtent = 4,
                        BlockExtentSq = BlockExtent * BlockExtent,
                        BiomeExtentSq = BiomeExtent * BiomeExtent,
                        BlockExtentCub = BlockExtentSq * BlockExtent,
                        BiomeExtentCub = BiomeExtentSq * BiomeExtent;

